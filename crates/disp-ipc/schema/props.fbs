/// An Emacs string in special encodings
table EmacsString {
  /// The underlying data
  data: [ubyte] (required);
  /// The length in chars and encoding info
  ///
  /// The length is signed:
  /// - Positive: Encoded in `utf-8-emacs` coding.
  /// - Negative: Encoded in `raw-text` (bytes).
  length: int64;
  /// Text properties
  properties: [TextSpan];
}
table TextSpan {
  length: int32;
  continued: int32;
  properties: TextProps;
}

/// Workaround for union { bool, uint64 } for colors
struct BoolColor {
  /// RRRRGGGGBBBBAAAF (F: 0xFF: t; 0: nil; others: color)
  color: uint64;
}
/// Workaround for union { bool, int }
struct BoolInt {
  b: bool;
  v: int;
}
/// Workaround for union { int, float }
struct IntFloat {
  /// Value, NaN-boxed int or float
  v: int;
}

struct FaceRef {
  id: int;
}
enum LineHeightKind : ubyte {
  no_effect,
  height_total,
  absolute,
  relative,
}
struct LineHeight {
  kind: LineHeightKind;
  car: IntFloat;
  cdr: IntFloat;
}
union PrefixSpec {
  EmacsString,
  ImageSpec,
  SpacingSpec,
}
table Composition {
  length: int;
  components: string;
  notify: bool;
}
struct SliceSpec {
  x: IntFloat;
  y: IntFloat;
  w: IntFloat;
  h: IntFloat;
}
union MarginSpec {
  EmacsString,
  ImageSpec,
}
struct BitmapRef {
  id: int;
}
struct FringeSpec {
  image: BitmapRef;
  face: FaceRef;
}
table WhenSpec {
  condition: AnyForm;
  display: DisplaySpec;
}
struct PrioritySpec {
  primary: uint;
  secondary: uint;
}
struct WindowRef {
  id: int;
}
enum Continued : uint (bit_flags) {
  min_width,
  display,
  face,
  mouse_face,
  fontified,
  help_echo,
  invisible,
  cursor,
  pointer,
  line_spacing,
  line_height,
  wrap_prefix,
  line_prefix,
  composition,
  display_line_numbers_disable,
}
table AnyForm {
  atom: bool;
  v: IntFloat;
}
table PixelSpec {
  expr: [int];
  vars: [string];
}
table SpacingSpec {
  width: PixelSpec;
  height: PixelSpec;
  relative_width: float;
  relative_height: float;
  align_to: PixelSpec;
  ascent: PixelSpec;
}
enum ImageType : ubyte {
  postscript,
  imagemagick,
  svg,
  png,
  gif,
  tiff,
  jpeg,
  xpm,
  webp,
  xbm,
  pbm,
}
enum PointerEnum : ubyte {
  arrow,
  hand,
  text,
  hdrag,
  nhdrag,
  vdrag,
  hourglass,
  modeline,
}
struct ImageMargin {
  x: int;
  y: int;
}
enum ImageConversion : ubyte {
  none,
  disabled,
}
table ImageSpec {
  kind: ImageType;
  file: string;
  data: [ubyte];
  margin: ImageMargin;
  ascent: IntFloat;
  relief: int;
  width: int;
  height: int;
  max_width: int;
  max_height: int;
  scale: float;
  rotation: int;
  flip: bool;
  transform_smoothing: bool;
  index: int;
  conversion: ImageConversion;
  mask: BoolColor;
  pointer: PointerEnum;
  map_notify: bool;
}

enum FaceWidth : ubyte {
  ultra_condensed,
  extra_condensed,
  condensed,
  semi_condensed,
  normal,
  semi_expanded,
  expanded,
  extra_expanded,
  ultra_expanded,
}
enum FaceWeight : ubyte {
  thin,
  ultra_light,
  light,
  semi_light,
  regular,
  medium,
  semi_bold,
  bold,
  extra_bold,
  black,
  ultra_heavy,
}
enum FaceSlant : ubyte {
  reverse_oblique,
  reverse_italic,
  normal,
  italic,
  oblique,
}
enum UnderlineStyle : ubyte {
  line,
  double_line,
  wave,
  dots,
  dashes,
}
struct FaceUnderline {
  color: BoolColor;
  style: UnderlineStyle;
  position: int;
}
struct LineWidth {
  vwidth: int;
  hwidth: int;
}
enum BoxStyle : ubyte {
  released_button,
  pressed_button,
  flat_button,
}
struct FaceBox {
  line_width: LineWidth;
  color: BoolColor;
  style: BoxStyle;
}
table FaceDef {
  family: string;
  foundry: string;
  height: IntFloat;
  swidth: FaceWidth;
  weight: FaceWeight;
  slant: FaceSlant;
  foreground: BoolColor;
  distant_foreground: BoolColor;
  background: BoolColor;
  underline: FaceUnderline;
  overline: BoolColor;
  strike_through: BoolColor;
  box: FaceBox;
  inverse: bool;
  stipple: int;
  inherit: [int];
  font: string;
  fontset: [string];
  extend: bool;
}

table TextProps {
  display: DisplaySpec;
  face: FaceRef;
  mouse_face: FaceRef;
  fontified: bool;
  help_echo: bool;
  invisible: bool;
  cursor: BoolInt;
  pointer: PointerEnum;
  line_spacing: LineHeight;
  line_height: LineHeight;
  wrap_prefix: PrefixSpec;
  line_prefix: PrefixSpec;
  composition: Composition;
  display_line_numbers_disable: bool;
}
table OverlayProps {
  priority: PrioritySpec;
  window: WindowRef;
  face: FaceRef;
  mouse_face: FaceRef;
  display: DisplaySpec;
  invisible: bool;
  before_string: EmacsString;
  after_string: EmacsString;
  wrap_prefix: PrefixSpec;
  line_prefix: PrefixSpec;
  display_line_numbers_disable: bool;
}

table DisplaySpec {
  _string: EmacsString;
  space: PixelSpec;
  image: ImageSpec;
  slice: SliceSpec;
  margin_nil: MarginSpec;
  margin_left_margin: MarginSpec;
  margin_right_margin: MarginSpec;
  left_fringe: FringeSpec;
  right_fringe: FringeSpec;
  space_width: IntFloat;
  min_width: PixelSpec;
  height: AnyForm;
  raise: IntFloat;
  when: WhenSpec;
}
